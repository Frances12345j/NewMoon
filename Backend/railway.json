{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "composer install --no-dev --optimize-autoloader && php artisan storage:link && npm ci && npm run build",
        "nixpacksPlan": {
            "phases": {
                "setup": {
                    "aptPkgs": [
                        "php-mysql",
                        "php-xml",
                        "php-mbstring",
                        "php-curl",
                        "php-gd",
                        "php-intl",
                        "php-zip",
                        "php-bcmath"
                    ]
                }
            }
        }
    },
    "deploy": {
        "startCommand": "php -S 0.0.0.0:$PORT -t public server.php",
        "healthcheckPath": "/up",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}